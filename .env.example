# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env itself is gitignored -- never commit real tokens/keys.
#
# Full field reference: app/core/config.py (Settings reads env vars prefixed
# HAROFRAME_, nested delimiter __).

# Required to download gated/rate-limited Hugging Face models.
HAROFRAME_IDENTITY__HF_TOKEN=

# Exactly one face adapter must be enabled -- both true raises
# ConflictingAdapterConfigError.
HAROFRAME_IDENTITY__IPADAPTER__ENABLED=true
HAROFRAME_IDENTITY__INSTANTID__ENABLED=false

# Optional: only needed if you install LoRAs from Civitai links that require auth.
HAROFRAME_GENERATION__LORA__CIVITAI_API_KEY=

# cuda on vast.ai; cpu only for local smoke-testing wiring (very slow for real generation).
HAROFRAME_IDENTITY__DEVICE=cuda
