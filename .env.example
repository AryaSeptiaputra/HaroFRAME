# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env itself is gitignored -- never commit real tokens/keys.
#
# Full field reference: app/core/config.py (Settings reads env vars prefixed
# HAROFRAME_, nested delimiter __).

# Required to download gated/rate-limited Hugging Face models. The default base
# model below is ungated, so this is only strictly needed for gated checkpoints.
HAROFRAME_IDENTITY__HF_TOKEN=

# Base SDXL checkpoint. Default is RealVisXL V5.0 -- picked for human anatomy and
# pose, which is what this pipeline spends all its effort on. Accepts an HF
# repo_id, a local diffusers dir, a local .safetensors, or a Civitai/direct URL.
# Alternative worth trying: RunDiffusion/Juggernaut-XL-v9
HAROFRAME_IDENTITY__BASE_SDXL_MODEL=SG161222/RealVisXL_V5.0

# LoRAs, as a JSON list -- installed automatically by scripts/prefetch_models.py
# at instance setup. Same four source kinds as the base model. No LoRA ships
# enabled by default; add your own here.
#   adapter_name must be unique and must not be "faceid" (reserved).
# HAROFRAME_GENERATION__LORA__ENTRIES=[{"adapter_name":"detail","source":"https://civitai.com/models/122359","scale":0.6}]

# Prefetch base model + LoRAs + SAM checkpoint during entrypoint.sh instead of
# lazily on first generate. Set false on a metered connection, or when
# .cache/models is a persistent volume you have already populated.
HAROFRAME_PREFETCH=true

# Exactly one face adapter must be enabled -- both true raises
# ConflictingAdapterConfigError.
HAROFRAME_IDENTITY__IPADAPTER__ENABLED=true
HAROFRAME_IDENTITY__INSTANTID__ENABLED=false

# Stage-1 inpaint (changes clothing / generates body regions before the render
# stage) is ON by default, so every run needs a stage-1 prompt as well as the
# render prompt. Set a default here to avoid typing --inpaint-prompt each time,
# or set ENABLED=false to go back to single-stage generation. Leaving the stage
# on with an empty prompt makes the scripts stop with a message.
# Its SAM checkpoint is downloaded automatically by prefetch_models.py.
HAROFRAME_GENERATION__INPAINT__ENABLED=true
HAROFRAME_GENERATION__INPAINT__PROMPT=
# vit_b (375MB, default) / vit_l (1.25GB) / vit_h (2.56GB) -- bigger = better masks.
# HAROFRAME_GENERATION__INPAINT__SAM__MODEL_TYPE=vit_b
# HAROFRAME_GENERATION__INPAINT__SAM__CHECKPOINT_PATH=.cache/models/sam/sam_vit_b_01ec64.pth

# Optional: only needed if you install LoRAs from Civitai links that require auth.
HAROFRAME_GENERATION__LORA__CIVITAI_API_KEY=

# cuda on vast.ai; cpu only for local smoke-testing wiring (very slow for real generation).
HAROFRAME_IDENTITY__DEVICE=cuda
